# Copie para server/.env e preencha. Vazio = modo demonstração (dados falsos).
# Chaves em dashboard.pluggy.ai > sua aplicação.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Opcional: IDs de itens criados fora do app (ex.: pelo Demo do dashboard), separados por vírgula.
PLUGGY_ITEM_IDS=
PORT=3333
# Senha de acesso ao app (mínimo 12 caracteres). Vazia = sem login, e aí só roda em 127.0.0.1.
APP_PASSWORD=
# Na nuvem: HOST=0.0.0.0 (exige APP_PASSWORD). Padrão 127.0.0.1 = só este computador.
# HOST=0.0.0.0
